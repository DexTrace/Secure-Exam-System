<Window x:Class="SecureExam.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SecureExam.Desktop.Controls"
        Title="Secure Exam System"
        Width="1360"
        Height="860"
        MinWidth="1000"
        MinHeight="680"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid x:Name="LoginScreen" Visibility="Visible">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="0.9*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#102F53" Offset="0" />
            <GradientStop Color="#1C4D79" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel Margin="64" VerticalAlignment="Center">
          <Border Width="48" Height="48" HorizontalAlignment="Left" CornerRadius="14"
                  Background="#244A76" BorderBrush="#426B94" BorderThickness="1">
            <TextBlock Text="SE" Foreground="White" FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Margin="0,20,0,0" Text="SECURE EXAM SYSTEM" Foreground="#AFC7E5"
                     FontSize="11" FontWeight="Bold" />
          <TextBlock Margin="0,16,0,14" Text="Protecting the integrity of every examination."
                     Foreground="White" FontSize="36" FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock MaxWidth="500"
                     Text="A controlled workspace for exam setters, reviewers, administrators, and investigators."
                     Foreground="#D7E4F5" FontSize="15" LineHeight="24" TextWrapping="Wrap" />
          <Border Margin="0,36,0,0" Padding="18" Background="#244A76" CornerRadius="10"
                  BorderBrush="#426B94" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="SECURITY BUILT INTO SIGN-IN" Foreground="#AFC7E5"
                         FontSize="10" FontWeight="Bold" />
              <TextBlock Margin="0,8,0,0"
                         Text="Multi-factor authentication · Approved workstations · Server-enforced roles"
                         Foreground="White" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1">
        <Border Width="430" Padding="38" VerticalAlignment="Center" Background="White"
                CornerRadius="14" BorderBrush="#E3E9F0" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="LoginHeading" Text="Welcome back" Foreground="{StaticResource InkBrush}"
                       FontSize="27" FontWeight="SemiBold" />
            <TextBlock x:Name="LoginSubheading" Margin="0,8,0,26"
                       Text="Sign in with your Secure Exam account."
                       Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" />
            <StackPanel x:Name="CredentialsPanel">
              <TextBlock Text="Email address" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
              <TextBox x:Name="EmailInput" Margin="0,8,0,18" Height="44"
                       VerticalContentAlignment="Center" />
              <TextBlock Text="Password" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
              <controls:SecureEntry x:Name="PasswordInput" Margin="0,8,0,20" />
            </StackPanel>
            <StackPanel x:Name="MfaPanel" Visibility="Collapsed">
              <Border x:Name="MfaSetupPanel" Margin="0,0,0,16" Padding="13"
                      Background="#EFF6FF" BorderBrush="#C7DDF5" BorderThickness="1"
                      CornerRadius="6" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="Set up your authenticator app" Foreground="{StaticResource InkBrush}"
                             FontWeight="SemiBold" />
                  <TextBlock Margin="0,6,0,0" Text="Add this key to your authenticator, then enter its current six-digit code:"
                             Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                  <TextBox x:Name="MfaSecretText" Margin="0,8,0,0" IsReadOnly="True" FontSize="12" />
                </StackPanel>
              </Border>
              <TextBlock Text="Authenticator code" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
              <TextBox x:Name="MfaCodeInput" Margin="0,8,0,18" Height="44"
                       VerticalContentAlignment="Center" MaxLength="6"
                       HorizontalContentAlignment="Center" FontSize="20" />
            </StackPanel>
            <Button x:Name="LoginButton" Height="46" Background="{StaticResource NavyBrush}"
                    Foreground="White" FontWeight="SemiBold" Content="Continue"
                    Click="LoginButton_Click" />
            <Button x:Name="BackButton" Margin="0,8,0,0" Background="Transparent"
                    Foreground="{StaticResource MutedBrush}" Content="Back to sign in"
                    Click="BackButton_Click" Visibility="Collapsed" />
            <TextBlock x:Name="LoginMessage" Margin="0,14,0,0" Foreground="#B42318"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,18,0,0" Text="Sessions expire after 8 hours. Sign-in requires an approved workstation."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Grid x:Name="ApplicationScreen" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#102F53" BorderBrush="#244A76" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
            <DockPanel>
              <Border Width="34" Height="34" CornerRadius="10" Background="#244A76"
                      BorderBrush="#426B94" BorderThickness="1">
                <TextBlock Text="SE" Foreground="White" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="SECURE EXAM" Foreground="White" FontSize="13" FontWeight="Bold" />
                <TextBlock Margin="0,2,0,0" Text="EXAM OPERATIONS" Foreground="#AFC7E5"
                           FontSize="9" FontWeight="SemiBold" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="14">
            <Border Margin="0,0,0,12" Padding="12" Background="#183858" CornerRadius="9"
                    BorderBrush="#294B6D" BorderThickness="1">
              <DockPanel>
                <Border Width="34" Height="34" CornerRadius="17" Background="#2D5A80">
                  <TextBlock Text="●" Foreground="#8FE0C8" FontSize="12"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="UserNameLabel" Foreground="White" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="UserRoleLabel" Margin="0,3,0,0" Foreground="#AFC7E5"
                             FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
            </Border>
            <TextBlock x:Name="SessionExpiryLabel" Margin="4,0,4,8" Foreground="#AFC7E5" FontSize="10" />
            <Button Content="Sign out" HorizontalContentAlignment="Left" Background="Transparent"
                    BorderBrush="#355677" Foreground="#D7E4F5" Click="LogoutButton_Click" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="NavigationPanel" Margin="10,0,10,14" />
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="88" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F0" BorderThickness="0,0,0,1">
          <DockPanel Margin="32,0">
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="PageTitle" Foreground="{StaticResource InkBrush}"
                         FontSize="21" FontWeight="SemiBold" />
              <TextBlock x:Name="PageDescription" Margin="0,4,16,0"
                         Foreground="{StaticResource MutedBrush}" FontSize="11"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Margin="12,20,0,20"
                    Background="#EAF0F7" Foreground="{StaticResource NavyBrush}"
                    BorderBrush="#DCE5F0" Content="Refresh" Click="RefreshButton_Click" />
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,26,32,32">
            <WrapPanel x:Name="DashboardCards" Visibility="Collapsed" />
            <StackPanel x:Name="ModuleContent" />
            <TextBlock x:Name="StatusMessage" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
