<UserControl x:Class="SecureExam.Desktop.Views.PaperWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <StackPanel x:Name="ListPanel">
      <DockPanel Margin="0,0,0,16">
        <TextBlock Text="Question papers" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        <Button x:Name="NewPaperButton" DockPanel.Dock="Right" Content="New paper"
                Background="{StaticResource NavyBrush}" Foreground="White" Click="NewPaperButton_Click" />
        <Button x:Name="AccessAuditButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                Content="Access audit" Background="#EAF0F7" Foreground="{StaticResource NavyBrush}"
                Click="AccessAuditButton_Click" />
        <Button x:Name="VerifyCopyButton" DockPanel.Dock="Right" Margin="0,0,8,0"
                Content="Verify recovered PDF" Background="#EAF0F7" Foreground="{StaticResource NavyBrush}"
                Click="VerifyCopyButton_Click" />
      </DockPanel>
      <TextBlock x:Name="ListMessage" Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}"
                 TextWrapping="Wrap" />
      <StackPanel x:Name="PaperList" />
    </StackPanel>

    <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
      <DockPanel Margin="0,0,0,14">
        <Button Content="Back to papers" Click="BackToListButton_Click"
                Background="#EAF0F7" Foreground="{StaticResource NavyBrush}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="VersionsButton" Margin="8,0,0,0" Content="Version history"
                  Background="#EAF0F7" Foreground="{StaticResource NavyBrush}" Click="VersionsButton_Click" />
          <Button x:Name="SubmitButton" Margin="8,0,0,0" Content="Submit paper"
                  Background="{StaticResource NavyBrush}" Foreground="White" Click="SubmitButton_Click" />
          <Button x:Name="ApproveButton" Margin="8,0,0,0" Content="Approve"
                  Background="#176B3A" Foreground="White" Click="ApproveButton_Click" />
          <Button x:Name="RequestChangesButton" Margin="8,0,0,0" Content="Request changes"
                  Background="#FFF4DB" Foreground="#845B00" Click="RequestChangesButton_Click" />
          <Button x:Name="RejectButton" Margin="8,0,0,0" Content="Reject"
                  Background="#FDECEC" Foreground="#A62525" Click="RejectButton_Click" />
          <Button x:Name="ExportButton" Margin="8,0,0,0" Content="Export"
                  Background="#EAF0F7" Foreground="{StaticResource NavyBrush}" Click="ExportButton_Click" />
          <Button x:Name="PrintButton" Margin="8,0,0,0" Content="Print"
                  Background="#EAF0F7" Foreground="{StaticResource NavyBrush}" Click="PrintButton_Click" />
        </StackPanel>
      </DockPanel>

      <Border Margin="0,0,0,14" Padding="16" Background="White" BorderBrush="#E3E9F0"
              BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="EditorTitle" Text="New question paper" FontSize="18"
                       FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            <TextBlock x:Name="PaperStateLabel" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
          </DockPanel>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="Paper title" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
              <TextBox x:Name="TitleInput" Margin="0,6,0,12" Height="40" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="Subject" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
              <TextBox x:Name="SubjectInput" Margin="0,6,0,12" Height="40" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="Exam code" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
              <TextBox x:Name="ExamCodeInput" Margin="0,6,0,0" Height="40" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="Total marks" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
              <TextBox x:Name="TotalMarksInput" Margin="0,6,0,0" Height="40" />
            </StackPanel>
          </Grid>
          <TextBlock Margin="0,14,0,0" Text="Sections and marks (one per line: Section A | 20)"
                     FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
          <TextBox x:Name="SectionsInput" Margin="0,6,0,0" Height="68" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
          <TextBlock Margin="0,14,0,0" Text="Instructions"
                     FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
          <TextBox x:Name="InstructionsInput" Margin="0,6,0,0" Height="72" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </Border>

      <Border Padding="16" Background="White" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="Questions" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BoldButton" Content="B" FontWeight="Bold" Padding="12,5"
                      Background="#EAF0F7" Foreground="{StaticResource NavyBrush}" Click="BoldButton_Click" />
              <Button x:Name="ItalicButton" Margin="5,0,0,0" Content="I" FontStyle="Italic" Padding="12,5"
                      Background="#EAF0F7" Foreground="{StaticResource NavyBrush}" Click="ItalicButton_Click" />
              <Button x:Name="UnderlineButton" Margin="5,0,0,0" Content="U" Padding="12,5"
                      Background="#EAF0F7" Foreground="{StaticResource NavyBrush}" Click="UnderlineButton_Click" />
            </StackPanel>
          </DockPanel>
          <RichTextBox x:Name="QuestionEditor" Margin="0,10,0,0" MinHeight="300"
                       Padding="12" BorderBrush="#D7DFE9" BorderThickness="1"
                       VerticalScrollBarVisibility="Auto" TextChanged="QuestionEditor_TextChanged" />
        </StackPanel>
      </Border>
      <DockPanel Margin="0,10,0,0">
        <TextBlock x:Name="SaveStateLabel" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SaveButton" Content="Save now" Background="#EAF0F7"
                  Foreground="{StaticResource NavyBrush}" Click="SaveButton_Click" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Grid>
</UserControl>
