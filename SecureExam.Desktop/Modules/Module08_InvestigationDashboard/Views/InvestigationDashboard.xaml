<UserControl x:Class="SecureExam.Desktop.Views.InvestigationDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Padding="18" Background="White" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <TextBlock Text="Search evidence" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" />
        <TextBlock Margin="0,5,0,10" Text="Search using an exact paper ID, issued copy ID, or registered incident ID."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="SearchTypeInput" Height="40" Padding="8" SelectedIndex="0">
            <ComboBoxItem Content="Paper ID" Tag="paper" />
            <ComboBoxItem Content="Copy ID" Tag="copy" />
            <ComboBoxItem Content="Incident ID" Tag="incident" />
          </ComboBox>
          <TextBox x:Name="SearchValueInput" Grid.Column="1" Margin="8,0" Height="40"
                   Padding="9" VerticalContentAlignment="Center" />
          <Button x:Name="SearchButton" Grid.Column="2" Content="Search"
                  Background="{StaticResource NavyBrush}" Foreground="White" Click="SearchButton_Click" />
        </Grid>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Margin="0,14,0,0" Padding="18" Background="White" BorderBrush="#E3E9F0"
            BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <TextBlock Text="Register incident" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" />
        <TextBlock Margin="0,5,0,8" Text="Create a searchable incident record linked to a paper or issued copy."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        <TextBox x:Name="IncidentSummaryInput" MinHeight="66" MaxLength="1000"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 ToolTip="Incident summary (required)" />
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="IncidentPaperIdInput" Height="40" Padding="9"
                   VerticalContentAlignment="Center" ToolTip="Paper ID (optional if copy ID is entered)" />
          <TextBox x:Name="IncidentCopyIdInput" Grid.Column="1" Margin="8,0" Height="40" Padding="9"
                   VerticalContentAlignment="Center" ToolTip="Copy ID (optional)" />
          <Button x:Name="CreateIncidentButton" Grid.Column="2" Content="Create incident"
                  Background="#EAF0F7" Foreground="{StaticResource NavyBrush}"
                  Click="CreateIncidentButton_Click" />
        </Grid>
      </StackPanel>
    </Border>

    <DockPanel Margin="0,16,0,8">
      <TextBlock Text="Investigation evidence" FontSize="17" FontWeight="SemiBold"
                 Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
      <Button x:Name="SaveReportButton" DockPanel.Dock="Right" Content="Save evidence report"
              Background="#EAF0F7" Foreground="{StaticResource NavyBrush}"
              IsEnabled="False" Click="SaveReportButton_Click" />
    </DockPanel>
    <StackPanel x:Name="ReportPanel" />
  </StackPanel>
</UserControl>
