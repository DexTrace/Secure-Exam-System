<UserControl x:Class="SecureExam.Desktop.Views.AlertManagementDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Padding="18" Background="White" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="8">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="Security alerts" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}" />
          <TextBlock Margin="0,5,12,0"
                     Text="Alerts are generated from server-observed authentication, access, device and export events."
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Button x:Name="RefreshAlertsButton" DockPanel.Dock="Right" Content="Refresh"
                Background="{StaticResource NavyBrush}" Foreground="White"
                Click="RefreshAlertsButton_Click" />
      </DockPanel>
    </Border>
    <TextBlock x:Name="StatusText" Margin="0,10,0,10" Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap" />
    <StackPanel x:Name="AlertList" />
    <TextBlock Margin="0,10,0,8" Text="Incident cases" FontSize="17" FontWeight="SemiBold"
               Foreground="{StaticResource InkBrush}" />
    <StackPanel x:Name="CaseList" />
  </StackPanel>
</UserControl>
