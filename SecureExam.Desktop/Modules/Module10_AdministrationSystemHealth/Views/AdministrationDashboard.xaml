<UserControl x:Class="SecureExam.Desktop.Views.AdministrationDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Padding="18" Background="White" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="8">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="System health" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}" />
          <TextBlock Margin="0,5,12,0"
                     Text="Connectivity, database integrity, effective security policy and recovery backups."
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh"
                Background="{StaticResource NavyBrush}" Foreground="White"
                Click="RefreshButton_Click" />
      </DockPanel>
    </Border>
    <TextBlock x:Name="StatusText" Margin="0,10,0,10" Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap" />
    <Border Margin="0,0,0,12" Padding="18" Background="White" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <TextBlock Text="Connectivity and integrity" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" />
        <TextBlock x:Name="HealthDetails" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Margin="0,0,0,12" Padding="18" Background="White" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <TextBlock Text="Effective security and retention policy" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" />
        <TextBlock x:Name="PolicyDetails" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,10,0,0"
                   Text="Policies are configured in the API service environment and require an API restart. Audit history is append-only and is not automatically purged."
                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Margin="0,0,0,12" Padding="18" Background="White" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <TextBlock Text="Application updates" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" />
        <TextBlock x:Name="VersionDetails" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0"
                   Text="Updates are deployed by the system administrator from a trusted, signed release. This app does not download or execute updates."
                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border Padding="18" Background="White" BorderBrush="#E3E9F0" BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <DockPanel>
          <TextBlock Text="Recovery backups" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}" />
          <Button x:Name="CreateBackupButton" DockPanel.Dock="Right" Content="Create backup"
                  Background="{StaticResource NavyBrush}" Foreground="White"
                  Click="CreateBackupButton_Click" />
        </DockPanel>
        <TextBlock Margin="0,8,0,12"
                   Text="Creates a consistent SQLite backup together with the complete Data Protection key ring on the API host. It is not downloaded to this workstation."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        <StackPanel x:Name="BackupList" />
        <TextBlock Margin="0,12,0,0"
                   Text="Protect the backup directory with server-side access controls and include the matching private key-encryption certificate in recovery planning. Restore only with the API stopped."
                   Foreground="#845B00" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
